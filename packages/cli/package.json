{
  "name": "kobi-xray",
  "version": "0.1.0",
  "description": "Turn any Git repository into a navigable 3D city with time travel. Runs locally.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kobi-xray": "./dist/bin.js"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codebase",
    "visualization",
    "architecture",
    "git",
    "tree-sitter",
    "code-city"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/bundle.mjs && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@kobi-xray/core": "0.1.0",
    "esbuild": "^0.28.2"
  },
  "homepage": "https://xray.yaakovcarioca.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaakovcarioca/kobi-x-ray.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/yaakovcarioca/kobi-x-ray/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
