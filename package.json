{
  "name": "kobi-xray-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Codebase Time-Travel & Architecture X-Ray",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @kobi-xray/core && npm run build -w @kobi-xray/web && npm run build -w kobi-xray",
    "dev": "npm run dev -w @kobi-xray/web",
    "start": "node packages/cli/dist/bin.js",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "marketing:shots": "node marketing/shots.mjs",
    "marketing:cards": "node marketing/cards.mjs",
    "marketing:video": "node marketing/video.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
